{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "worker-ui",
  "description": "The worker's local UI, served by the worker on the loopback address. It gets only what it needs.",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": ["allow-pick-folder", "allow-autostart-get", "allow-autostart-set", "allow-open-logs", "allow-open-external", "allow-check-app-update"]
}

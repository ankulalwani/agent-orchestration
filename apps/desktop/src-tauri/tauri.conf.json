{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Agent Orchestration Worker",
  "mainBinaryName": "agent-orchestration-worker",
  "version": "../package.json",
  "identifier": "io.agent-orchestration.worker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "Runs coding agents on this machine for Agent Orchestration",
    "longDescription": "The Agent Orchestration worker as a desktop app: it connects this machine to your control plane and runs coding agents in the project folders you choose.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/ao-node"],
    "resources": {
      "resources/worker.tgz": "worker.tgz",
      "resources/WORKER_VERSION": "WORKER_VERSION"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGQzFDNUM4ODVGMEI5REEKUldUYXVmQ0Z5TVhCenlLbWlFMlcwbXFyYmlvekRHVmJYWmNBQWo1UzNsTkc2M241RmJYRlJlaDkK",
      "endpoints": ["https://github.com/ankulalwani/agent-orchestration/releases/latest/download/latest.json"]
    }
  }
}

# Agent Orchestration — control plane configuration (copy to .env and fill in).
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# REQUIRED: signs access tokens (>= 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# REQUIRED: 32-byte key (64 hex chars) that encrypts secrets at rest. Back it up: without it, stored secrets are unrecoverable.
ENCRYPTION_KEY=
# Only while rotating ENCRYPTION_KEY: former key(s), comma-separated (see docs/self-hosting).
# ENCRYPTION_KEYS_PREVIOUS=

# Public URLs (used in pairing links and emails). Behind a reverse proxy, set TRUST_PROXY=true.
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:4000
TRUST_PROXY=false

# Data stores. MongoDB is the source of truth; Redis enables BullMQ and multi-instance dispatch.
MONGODB_URI=mongodb://mongo:27017/agent_orchestration
REDIS_URL=redis://redis:6379

# Settings marked [web] can also be managed in the dashboard (Server settings) without a restart.
# A variable set here always wins and locks the setting in the dashboard, so leave [web] settings
# commented out if you want to manage them there.

# Accounts [web]
# ALLOW_REGISTRATION=true
# REQUIRE_EMAIL_VERIFICATION=false

# Email (optional) [web]. Without SMTP, emails are logged instead of sent.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# SMTP_FROM=Agent Orchestration <no-reply@example.com>

# Object storage (optional, S3-compatible e.g. MinIO) — reserved for artifacts; see KNOWN_LIMITATIONS.
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=agent-orchestration
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Outbound calls are off by default (self-hosted never phones home). [web]
# EXPO_PUSH_ENABLED=false
# TELEMETRY_ENABLED=false
# Sign-in providers [web], off unless set (redirect URI: <PUBLIC_URL>/api/v1/auth/oauth/<google|github|oidc>/callback).
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=
# OIDC_ISSUER= / OIDC_CLIENT_ID= / OIDC_CLIENT_SECRET= / OIDC_DISPLAY_NAME=
# Shared, multi-tenant installation: callback URLs of integrations must then be public https addresses.
# DEPLOYMENT_MODE=self-hosted
# REQUIRE_PUBLIC_CALLBACK_URLS=false   # unset: on when DEPLOYMENT_MODE=cloud
# The first account becomes platform administrator. Turn off if strangers can sign up before you do, and use
#   docker compose exec control-plane node apps/api/dist/main.js platform-admin you@example.com
# FIRST_USER_IS_PLATFORM_ADMIN=true
# Error tracking [web], off unless set: a Sentry-compatible DSN and/or a JSON webhook.
# ERROR_TRACKING_DSN=https://<key>@sentry.example.com/<project>
# ERROR_TRACKING_WEBHOOK_URL=
# Feature flags forced on for everyone (otherwise managed in the dashboard: Feature flags).
# FEATURE_FLAGS=
# Capability marketplace: text (MongoDB text index) or atlas (Atlas Search index "capability_packages").
# REGISTRY_SEARCH=text
# Serve public marketplace packages without sign-in at /api/v1/catalog (unset: on when DEPLOYMENT_MODE=cloud).
# PUBLIC_CATALOG=false
# One-click worker install: release public keys as JSON, key id -> PEM. Without one the install command refuses to run.
# Keep it on one line: write the PEM line breaks as backslash-n.
# WORKER_RELEASE_TRUSTED_KEYS={"release-2026":"<PEM public key, one line>"}
METRICS_ENABLED=true
LOG_LEVEL=info

    "jose": "^5.9.6",
    "playwright": "1",
    "smtp-server": "^3.13.6",
    "tar": "^7.4.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
